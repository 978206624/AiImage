generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model ApiKey {
  id            Int           @id @default(autoincrement())
  key           String        @unique @db.VarChar(20)
  totalCredits  Decimal       @map("total_credits") @db.Decimal(10, 2)
  usedCredits   Decimal       @default(0) @map("used_credits") @db.Decimal(10, 2)
  status        String        @default("active") @db.VarChar(20)
  lastUsedAt    DateTime?     @map("last_used_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  usageRecords  UsageRecord[]

  @@map("api_keys")
}

model UsageRecord {
  id             Int      @id @default(autoincrement())
  apiKeyId       Int      @map("api_key_id")
  creditsUsed    Decimal  @map("credits_used") @db.Decimal(10, 2)
  promptSummary  String?  @map("prompt_summary") @db.VarChar(200)
  imageUrl       String?  @map("image_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
  @@map("usage_records")
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String   @map("image_url") @db.Text
  prompt      String?  @db.Text
  modelTag    String   @map("model_tag") @db.VarChar(50)
  styleTag    String   @map("style_tag") @db.VarChar(50)
  isFeatured  Boolean  @default(false) @map("is_featured")
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gallery_images")
}

model Category {
  id        Int              @id @default(autoincrement())
  name      String           @db.VarChar(50)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  templates PromptTemplate[]

  @@map("categories")
}

model PromptTemplate {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  prompt        String   @db.Text
  categoryId    Int      @map("category_id")
  coverImageUrl String?  @map("cover_image_url") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  category      Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("prompt_templates")
}

model StylePreset {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(200)
  coverImageUrl String?  @map("cover_image_url") @db.Text
  promptPrefix  String   @map("prompt_prefix") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("style_presets")
}
