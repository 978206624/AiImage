generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model ModelConfig {
  id              Int      @id @default(autoincrement())
  displayName     String   @map("display_name") @db.VarChar(100)
  provider        String   @db.VarChar(20)
  modelId         String   @map("model_id") @db.VarChar(100)
  endpointType    String   @map("endpoint_type") @db.VarChar(50)
  billingType     String   @map("billing_type") @db.VarChar(20)
  platformCost    Decimal? @map("platform_cost") @db.Decimal(10, 4)
  userCreditCost  Decimal  @map("user_credit_cost") @db.Decimal(10, 4)
  enabled         Boolean  @default(true)
  userSelectable  Boolean  @default(true) @map("user_selectable")
  sortOrder       Int      @default(0) @map("sort_order")
  concurrencyLimit Int     @default(3) @map("concurrency_limit")
  timeoutSeconds  Int      @default(120) @map("timeout_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("model_configs")
}

model ApiKey {
  id           Int           @id @default(autoincrement())
  key          String        @unique @db.VarChar(20)
  totalCredits Decimal       @map("total_credits") @db.Decimal(10, 2)
  usedCredits  Decimal       @default(0) @map("used_credits") @db.Decimal(10, 2)
  status       String        @default("active") @db.VarChar(20)
  lastUsedAt   DateTime?     @map("last_used_at")
  redeemedBy   Int?          @map("redeemed_by")
  redeemedAt   DateTime?     @map("redeemed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  redeemedUser User?         @relation(fields: [redeemedBy], references: [id])
  usageRecords UsageRecord[]

  @@index([redeemedBy])
  @@map("api_keys")
}

model UsageRecord {
  id            Int      @id @default(autoincrement())
  apiKeyId      Int?     @map("api_key_id")
  userId        Int?     @map("user_id")
  creditsUsed   Decimal  @map("credits_used") @db.Decimal(10, 2)
  promptSummary String?  @map("prompt_summary") @db.VarChar(200)
  imageUrl      String?  @map("image_url") @db.Text
  paramsJson    String?  @map("params_json") @db.Text
  isPersisted   Boolean  @default(true) @map("is_persisted")
  createdAt     DateTime @default(now()) @map("created_at")
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([apiKeyId])
  @@index([userId])
  @@map("usage_records")
}

model GalleryImage {
  id          Int       @id @default(autoincrement())
  imageUrl    String    @map("image_url") @db.Text
  prompt      String?   @db.Text
  modelTag    String    @map("model_tag") @db.VarChar(50)
  styleTag    String    @map("style_tag") @db.VarChar(50)
  title       String?   @db.VarChar(100)
  categoryId  Int?      @map("category_id")
  width       Int?
  height      Int?
  isFeatured  Boolean   @default(false) @map("is_featured")
  isPublished Boolean   @default(true) @map("is_published")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("gallery_images")
}

model Category {
  id            Int              @id @default(autoincrement())
  name          String           @db.VarChar(50)
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  templates     PromptTemplate[]
  galleryImages GalleryImage[]

  @@map("categories")
}

model PromptTemplate {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  prompt        String   @db.Text
  categoryId    Int      @map("category_id")
  coverImageUrl String?  @map("cover_image_url") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  category      Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("prompt_templates")
}

model StylePreset {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  coverImageUrl String?  @map("cover_image_url") @db.Text
  promptPrefix  String   @map("prompt_prefix") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("style_presets")
}

model User {
  id               Int           @id @default(autoincrement())
  email            String        @unique @db.VarChar(190)
  passwordHash     String        @map("password_hash") @db.VarChar(100)
  balance          Decimal       @default(0) @db.Decimal(10, 2)
  emailVerified    Boolean       @default(false) @map("email_verified")
  hasReceivedBonus Boolean       @default(false) @map("has_received_bonus")
  registerIp       String?       @map("register_ip") @db.VarChar(45)
  status           String        @default("active") @db.VarChar(20)
  lastLoginAt      DateTime?     @map("last_login_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  redeemedKeys     ApiKey[]
  usageRecords     UsageRecord[]
  emailTokens      EmailToken[]
  imageTasks       ImageTask[]

  @@map("users")
}

model EmailToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique @db.VarChar(100)
  type      String    @db.VarChar(20)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model RegistrationAttempt {
  id        Int      @id @default(autoincrement())
  ip        String   @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@map("registration_attempts")
}

model ImageTask {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  groupId             String   @map("group_id") @db.VarChar(40)
  status              String   @default("pending") @db.VarChar(20)
  externalTaskId      String?  @map("external_task_id") @db.VarChar(120)
  failReason          String?  @map("fail_reason") @db.Text
  prompt              String   @db.Text
  promptSummary       String   @map("prompt_summary") @db.VarChar(200)
  aspectRatio         String   @map("aspect_ratio") @db.VarChar(20)
  quality             String   @db.VarChar(20)
  size                String   @db.VarChar(20)
  referenceImagesJson String?  @map("reference_images_json") @db.Text
  stylePresetId       Int?     @map("style_preset_id")
  creditsLocked       Decimal  @map("credits_locked") @db.Decimal(10, 2)
  refunded            Boolean  @default(false)
  progress            Int      @default(0)
  imageUrl            String?  @map("image_url") @db.Text
  isPersisted         Boolean  @default(false) @map("is_persisted")
  usageRecordId       Int?     @map("usage_record_id")
  provider            String?  @map("provider") @db.VarChar(20)
  model               String?  @db.VarChar(100)
  paramsJson          String?  @map("params_json") @db.Text
  upstreamRaw         String?  @map("upstream_raw") @db.Text
  lockedBy            String?  @map("locked_by") @db.VarChar(100)
  lockExpiresAt       DateTime? @map("lock_expires_at")
  attemptCount        Int      @default(0) @map("attempt_count")
  maxAttempts         Int      @default(2) @map("max_attempts")
  nextRunAt           DateTime? @map("next_run_at")
  idempotencyKey      String?  @map("idempotency_key") @db.VarChar(100)
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  source              String   @default("poll") @map("source")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([groupId])
  @@index([status])
  @@unique([idempotencyKey])
  @@map("image_tasks")
}

model AdminUserAuditLog {
  id           Int      @id @default(autoincrement())
  adminId      Int      @default(0) @map("admin_id")
  targetUserId Int      @map("target_user_id")
  action       String   @db.VarChar(40)
  payload      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetUserId, createdAt])
  @@map("admin_user_audit_log")
}

model AdminLoginAttempt {
  id          Int      @id @default(autoincrement())
  ip          String   @db.VarChar(45)
  attemptedAt DateTime @default(now()) @map("attempted_at")
  success     Boolean  @default(false)

  @@index([ip, attemptedAt])
  @@map("admin_login_attempts")
}
