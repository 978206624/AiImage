# Database
DATABASE_URL="mysql://root:password@localhost:3306/canvas"

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET="your-session-secret-change-in-production"

# Admin (initial password; once set via /admin/settings, DB value takes precedence)
ADMIN_PASSWORD="REDACTED"

# ============================================================
# 以下配置请通过 /admin/settings 页面在数据库中维护。
# env 仅作 fallback，可以留空。
# ============================================================

# GPT Image API (third-party proxy)
GPT_IMAGE_BASE_URL=""
GPT_IMAGE_API_KEY=""

# Aliyun OSS
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
OSS_REGION=""
OSS_ENDPOINT=""

# Credits per image generation
CREDITS_PER_IMAGE=""
